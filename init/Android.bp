cc_library_static {
    name: "libinit_msm8998",
    recovery_available: true,
    shared_libs: ["libbase"],
    srcs: ["init_msm8998.cpp"],
}

prebuilt_etc {
    name: "init.mmi.ramdump.rc",
    src: "init.mmi.ramdump.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.moto.rc",
    src: "init.moto.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.power.rc",
    src: "init.power.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.qcom.rc",
    src: "init.qcom.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.qcom.recovery.rc",
    src: "init.qcom.recovery.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "ueventd.qcom.rc",
    filename: "ueventd.rc",
    src: "ueventd.qcom.rc",
    vendor: true,
}

sh_binary {
    name: "init.gbmods.sh",
    src: "init.gbmods.sh",
    vendor: true,
}

sh_binary {
    name: "init.mmi.usb.sh",
    src: "init.mmi.usb.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.early_boot.sh",
    src: "init.qcom.early_boot.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.post_boot.sh",
    src: "init.qcom.post_boot.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.sensors.sh",
    src: "init.qcom.sensors.sh",
    vendor: true,
}

sh_binary {
    name: "init.qcom.sh",
    src: "init.qcom.sh",
    vendor: true,
}

sh_binary {
    name: "wlan_carrier_bin.sh",
    src: "wlan_carrier_bin.sh",
    vendor: true,
}
